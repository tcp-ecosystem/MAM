{
  "name": "@mam/compiler",
  "version": "0.1.0",
  "description": "MAM Compiler — Transpiles MAM AST to target languages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./targets/*": {
      "import": "./dist/targets/*.js",
      "types": "./dist/targets/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mam/ast": "workspace:*",
    "@mam/token-optimization": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@types/node": "^20.11.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mam",
    "compiler",
    "transpiler"
  ],
  "author": "MAM Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tcp-ecosystems/MAM.git",
    "directory": "compiler/"
  },
  "homepage": "https://github.com/tcp-ecosystems/MAM/tree/main/compiler",
  "bugs": {
    "url": "https://github.com/tcp-ecosystems/MAM/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
