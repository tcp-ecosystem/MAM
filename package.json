{
  "name": "mam-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "MAM — Markdown as Module: Universal module format for humans, LLMs, and agents",
  "author": "LifeJiggy",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "packageManager": "pnpm@8.14.0",
  "pnpm": {
    "overrides": {}
  }
}