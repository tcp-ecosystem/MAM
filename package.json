{
  "name": "mam-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MAM - Markdown as Module: System Description Language",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
