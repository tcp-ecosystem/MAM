{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MAM",
  "scopeName": "source.mam",
  "fileTypes": [
    "mam",
    "mam.md"
  ],
  "patterns": [
    {
      "include": "#frontmatter"
    },
    {
      "include": "#headings"
    },
    {
      "include": "#blockquote"
    },
    {
      "include": "#tables"
    },
    {
      "include": "#code-block"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#lists"
    },
    {
      "include": "#images"
    },
    {
      "include": "#links"
    },
    {
      "include": "#bold"
    },
    {
      "include": "#italic"
    },
    {
      "include": "#strikethrough"
    },
    {
      "include": "#code-inline"
    }
  ],
  "repository": {
    "frontmatter": {
      "begin": "^---\\s*$",
      "end": "^---\\s*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.frontmatter.mam"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.frontmatter.mam"
        }
      },
      "patterns": [
        {
          "match": "^\\s*#.*$",
          "name": "comment.line.number-sign.frontmatter.mam"
        },
        {
          "match": "^\\s{0,4}(runtime|permissions|capabilities|dependencies|tags|inputs|outputs|imports|exports|workflow|memory|prompts?|plugins|environment)\\s*:\\s*$",
          "name": "entity.name.tag.frontmatter.keyword.mam"
        },
        {
          "match": "^type\\s*:\\s*(module|system|component|service|workflow|tool|resource|plugin|agent|policy|team|memory|api)\\b",
          "captures": {
            "0": {
              "name": "meta.key-value.type.frontmatter.mam"
            },
            "1": {
              "name": "keyword.control.type.mam"
            }
          }
        },
        {
          "match": "^\\s{2,}(language|version|name|email)\\s*:\\s*(.*)$",
          "captures": {
            "1": {
              "name": "entity.name.tag.frontmatter.structured.mam"
            },
            "2": {
              "name": "string.unquoted.frontmatter.mam"
            }
          }
        },
        {
          "match": "^\\s{2,}[-*]\\s+(\\[[^\\]]*\\])\\s+(.*)$",
          "captures": {
            "1": {
              "name": "meta.sequence.item.flag.frontmatter.mam"
            },
            "2": {
              "name": "string.unquoted.frontmatter.mam"
            }
          }
        },
        {
          "match": "^\\s{2,}[-*]\\s+(.*)$",
          "captures": {
            "0": {
              "name": "punctuation.definition.list.frontmatter.mam"
            },
            "1": {
              "name": "string.unquoted.frontmatter.mam"
            }
          }
        },
        {
          "match": "^(\\w[\\w-]*)\\s*:\\s*(true|false|null)\\s*$",
          "captures": {
            "1": {
              "name": "entity.name.tag.frontmatter.mam"
            },
            "2": {
              "name": "constant.language.boolean.frontmatter.mam"
            }
          }
        },
        {
          "match": "^(\\w[\\w-]*)\\s*:\\s*(\\d+(?:\\.\\d+)?)\\s*$",
          "captures": {
            "1": {
              "name": "entity.name.tag.frontmatter.mam"
            },
            "2": {
              "name": "constant.numeric.frontmatter.mam"
            }
          }
        },
        {
          "match": "^(\\w[\\w-]*)\\s*:\\s*(['\"])(.*?)\\2\\s*$",
          "captures": {
            "1": {
              "name": "entity.name.tag.frontmatter.mam"
            },
            "2": {
              "name": "punctuation.definition.string.begin.frontmatter.mam"
            },
            "3": {
              "name": "string.quoted.frontmatter.mam"
            },
            "4": {
              "name": "punctuation.definition.string.end.frontmatter.mam"
            }
          }
        },
        {
          "match": "^(\\w[\\w-]*)\\s*:\\s*\\[([^\\]]*)\\]\\s*$",
          "captures": {
            "1": {
              "name": "entity.name.tag.frontmatter.mam"
            },
            "2": {
              "name": "meta.sequence.frontmatter.mam",
              "patterns": [
                {
                  "match": "(true|false|null)\\b",
                  "name": "constant.language.boolean.frontmatter.mam"
                },
                {
                  "match": "\\d+(?:\\.\\d+)?",
                  "name": "constant.numeric.frontmatter.mam"
                },
                {
                  "match": "['\"]([^'\"]*)['\"]",
                  "captures": {
                    "1": {
                      "name": "string.quoted.frontmatter.mam"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "match": "^(\\w[\\w-]*)\\s*:\\s*(.*)$",
          "captures": {
            "1": {
              "name": "entity.name.tag.frontmatter.mam"
            },
            "2": {
              "name": "string.unquoted.frontmatter.mam"
            }
          }
        },
        {
          "match": "^\\s{2,}.+$",
          "name": "string.unquoted.frontmatter.mam"
        },
        {
          "match": "(true|false|null)\\b",
          "name": "constant.language.boolean.frontmatter.mam"
        },
        {
          "match": "\\b\\d+(?:\\.\\d+)?\\b",
          "name": "constant.numeric.frontmatter.mam"
        },
        {
          "match": "['\"]([^'\"]*)['\"]",
          "captures": {
            "1": {
              "name": "string.quoted.frontmatter.mam"
            }
          }
        }
      ]
    },
    "headings": {
      "patterns": [
        {
          "match": "^(#{1,6})(?:\\s+)(.*)$",
          "name": "entity.name.section.mam",
          "captures": {
            "1": {
              "name": "punctuation.definition.heading.mam"
            }
          }
        }
      ]
    },
    "bold": {
      "match": "\\*\\*(.+?)\\*\\*",
      "captures": {
        "1": {
          "name": "markup.bold.mam"
        }
      }
    },
    "italic": {
      "match": "\\*(.+?)\\*",
      "captures": {
        "1": {
          "name": "markup.italic.mam"
        }
      }
    },
    "strikethrough": {
      "match": "~~(.+?)~~",
      "name": "markup.strikethrough.mam",
      "captures": {
        "1": {
          "name": "markup.strikethrough.mam"
        }
      }
    },
    "code-inline": {
      "match": "`([^`]+)`",
      "captures": {
        "1": {
          "name": "string.quoted.code.mam"
        }
      }
    },
    "code-block": {
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(mermaid))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.mermaid",
              "patterns": []
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(python|py))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.python",
              "patterns": [
                {
                  "include": "source.python"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(yaml|yml))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.yaml",
              "patterns": [
                {
                  "include": "source.yaml"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(json|jsonc))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.json",
              "patterns": [
                {
                  "include": "source.json"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(javascript|js|jsx|mjs|cjs))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.javascript",
              "patterns": [
                {
                  "include": "source.js"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(typescript|ts|tsx))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.typescript",
              "patterns": [
                {
                  "include": "source.ts"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(bash|sh|shell|zsh))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.shell",
              "patterns": [
                {
                  "include": "source.shell"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(powershell|ps1|pwsh))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.powershell",
              "patterns": [
                {
                  "include": "source.powershell"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(toml))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.toml",
              "patterns": [
                {
                  "include": "source.toml"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(sql))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.sql",
              "patterns": [
                {
                  "include": "source.sql"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(html|xml))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.html",
              "patterns": [
                {
                  "include": "text.html.basic"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(css|scss|less))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.css",
              "patterns": [
                {
                  "include": "source.css"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(diff|patch))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.diff",
              "patterns": [
                {
                  "include": "source.diff"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(markdown|md))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.markdown",
              "patterns": [
                {
                  "include": "text.html.markdown"
                }
              ]
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(text|plaintext|plain|txt))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.plaintext",
              "patterns": []
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        },
        {
          "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(\\w[\\w+#.-]*))$",
          "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
          "patterns": [
            {
              "begin": "(^|\\G)(\\s*)(.*)",
              "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
              "contentName": "meta.embedded.block.plaintext",
              "patterns": []
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          },
          "endCaptures": {
            "0": {
              "name": "comment.line.fence.mam"
            }
          }
        }
      ]
    },
    "lists": {
      "patterns": [
        {
          "match": "^\\s*[-*+]\\s+(\\[[ xX]\\])\\s+",
          "captures": {
            "0": {
              "name": "punctuation.definition.list.mam"
            },
            "1": {
              "name": "constant.language.task.mam"
            }
          }
        },
        {
          "match": "^\\s*[-*+]\\s+",
          "name": "punctuation.definition.list.mam"
        },
        {
          "match": "^\\s*\\d+\\.\\s+",
          "name": "punctuation.definition.list.ordered.mam"
        }
      ]
    },
    "tables": {
      "patterns": [
        {
          "match": "^\\|?\\s*:?-{3,}:?\\s*(?:\\|\\s*:?-{3,}:?\\s*)*\\|?\\s*$",
          "name": "meta.separator.table.mam"
        },
        {
          "match": "\\|",
          "name": "punctuation.separator.table.mam"
        }
      ]
    },
    "blockquote": {
      "begin": "^\\s*>\\s?",
      "end": "^(?!\\s*>)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.quote.mam"
        }
      },
      "name": "markup.quote.mam"
    },
    "images": {
      "match": "!\\[([^\\]]*)\\]\\(([^)]+)\\)",
      "captures": {
        "0": {
          "name": "markup.raw.image.mam"
        },
        "1": {
          "name": "string.unquoted.link.text.mam"
        },
        "2": {
          "name": "string.unquoted.link.url.mam"
        }
      }
    },
    "links": {
      "patterns": [
        {
          "match": "\\[([^\\]]+)\\]\\(([^)]+)\\)",
          "captures": {
            "1": {
              "name": "string.unquoted.link.text.mam"
            },
            "2": {
              "name": "string.unquoted.link.url.mam"
            }
          }
        },
        {
          "match": "\\[([^\\]]+)\\]\\[([^\\]]*)\\]",
          "captures": {
            "1": {
              "name": "string.unquoted.link.text.mam"
            },
            "2": {
              "name": "string.unquoted.link.reference.mam"
            }
          }
        }
      ]
    },
    "comments": {
      "begin": "<!--",
      "end": "-->",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.mam"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.mam"
        }
      },
      "name": "comment.block.html.mam"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(Purpose|Inputs|Outputs|Capabilities|Rules|Workflow|Dependencies|Permissions|Tests|Examples|References|Modules|Memory|Imports|Exports|Plugins|Prompt|Prompts)\\b",
          "name": "keyword.control.section.mam"
        },
        {
          "match": "\\b(module|system|component|service|workflow|tool|resource|plugin|agent|policy|team|memory|api)\\b",
          "name": "keyword.control.type.mam"
        },
        {
          "match": "\\b(required|optional|yes|no|true|false|mandatory)\\b",
          "name": "keyword.other.mam"
        },
        {
          "match": "->|=>",
          "name": "keyword.operator.edge.mam"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "->",
          "name": "keyword.operator.arrow.mam"
        },
        {
          "match": "=>",
          "name": "keyword.operator.fat-arrow.mam"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.pipe.mam"
        },
        {
          "match": "↓|\\^|→",
          "name": "keyword.operator.flow.mam"
        }
      ]
    }
  }
}
