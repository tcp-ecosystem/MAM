<?xml version="1.0" encoding="utf-8"?>
<VSIX xmlns="http://schemas.microsoft.com/developer/vsx-schema/2010">
  <Identifier Id="MAMLanguage" Version="0.1.0" LanguageId="en-US" Publisher="tcp-ecosystems">
    <Name>MAM Language</Name>
    <Description>MAM (Machine Agent Modules) language support: TextMate grammar and language definition for Visual Studio.</Description>
    <MoreInfoUrl>https://github.com/tcp-ecosystems/mam</MoreInfoUrl>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,18.0)" />
  </Identifier>
  <References>
    <Reference Id="Microsoft.VisualStudio.CoreUtility" MinVersion="17.0" />
  </References>
  <Content>
    <VSTemplate Path="MAM.vstemplate" />
  </Content>
</VSIX>