{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mam.dev/schema/v1.0.0/sections/prompt.schema.json",
  "title": "Prompt Section Schema",
  "description": "Defines prompt templates for LLM interactions — system prompts, user prompts, variable interpolation, role-based message structure, and response formatting.",
  "type": "object",
  "required": ["type", "name", "content"],
  "properties": {
    "type": { "type": "string", "const": "section" },
    "name": { "type": "string", "const": "Prompt" },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/Paragraph" },
          { "$ref": "#/definitions/List" },
          { "$ref": "#/definitions/CodeBlock" },
          { "$ref": "#/definitions/PromptTemplate" },
          { "$ref": "#/definitions/Table" },
          { "$ref": "#/definitions/Heading" }
        ]
      },
      "minItems": 1
    }
  },
  "definitions": {
    "Heading": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "value": { "type": "string" },
        "location": { "type": "object" }
      }
    },
    "Paragraph": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "paragraph" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "List": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "list" },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/definitions/Variable" }
            ]
          },
          "minItems": 1
        }
      }
    },
    "CodeBlock": {
      "type": "object",
      "required": ["type", "language", "value"],
      "properties": {
        "type": { "const": "codeblock" },
        "language": {
          "type": "string",
          "enum": ["text", "markdown", "jinja2", "mustache", "handlebars", "python", "json"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Prompt template content"
        },
        "title": {
          "type": "string",
          "description": "Label for this prompt block"
        },
        "role": {
          "type": "string",
          "enum": ["system", "user", "assistant", "tool"],
          "description": "Message role for this prompt"
        }
      }
    },
    "Table": {
      "type": "object",
      "required": ["type", "headers", "rows"],
      "properties": {
        "type": { "const": "table" },
        "headers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 5
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 5
          },
          "minItems": 1
        }
      }
    },
    "PromptTemplate": {
      "type": "object",
      "required": ["type", "name", "messages"],
      "properties": {
        "type": { "const": "prompt-template" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Template name for reference"
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/definitions/Message" },
          "minItems": 1,
          "description": "Ordered list of messages in the conversation"
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/definitions/Variable" },
          "description": "Variables used in this template"
        },
        "model": {
          "type": "string",
          "description": "Suggested model (e.g., 'gpt-4', 'claude-3', 'gemini-pro')"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7,
          "description": "Suggested temperature"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128000,
          "description": "Maximum response tokens"
        },
        "response_format": {
          "type": "string",
          "enum": ["text", "json", "json_object", "markdown"],
          "default": "text",
          "description": "Expected response format"
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/definitions/FewShotExample" },
          "description": "Few-shot examples for the prompt"
        }
      },
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["system", "user", "assistant", "tool"],
          "description": "Message role"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "Message content (may contain variable placeholders like {{variable_name}})"
        },
        "name": {
          "type": "string",
          "description": "Optional name for this message"
        },
        "condition": {
          "type": "string",
          "description": "Condition for including this message (e.g., '{{include_examples}}')"
        }
      }
    },
    "Variable": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Variable name (used as {{name}} in templates)"
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "array", "object", "context", "history"],
          "description": "Expected variable type"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "default": {
          "description": "Default value if not provided"
        },
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "enum": ["input", "context", "memory", "computed", "env"],
          "default": "input",
          "description": "Where this variable comes from"
        }
      }
    },
    "FewShotExample": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    }
  },
  "examples": [
    {
      "type": "section",
      "name": "Prompt",
      "content": [
        {
          "type": "prompt-template",
          "name": "classify_intent",
          "description": "Classify user intent from natural language",
          "messages": [
            { "role": "system", "content": "You are an intent classifier. Classify the user's message into one of: question, command, complaint, feedback." },
            { "role": "user", "content": "{{user_message}}" }
          ],
          "variables": [
            { "name": "user_message", "type": "string", "required": true, "source": "input", "description": "The user's raw message" }
          ],
          "model": "gpt-4",
          "temperature": 0.1,
          "response_format": "json",
          "examples": [
            { "input": "How do I reset my password?", "output": "{\"intent\": \"question\", \"confidence\": 0.95}" },
            { "input": "This app is terrible!", "output": "{\"intent\": \"complaint\", \"confidence\": 0.88}" }
          ]
        }
      ]
    }
  ]
}
