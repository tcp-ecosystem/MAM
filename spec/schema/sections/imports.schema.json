{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mam.dev/schema/v1.0.0/sections/imports.schema.json",
  "title": "Imports Section Schema",
  "description": "Declares what this module imports from other modules, standard libraries, and external packages. Supports aliasing, conditional imports, and version constraints.",
  "type": "object",
  "required": ["type", "name", "content"],
  "properties": {
    "type": { "type": "string", "const": "section" },
    "name": { "type": "string", "const": "Imports" },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/List" },
          { "$ref": "#/definitions/CodeBlock" },
          { "$ref": "#/definitions/Table" },
          { "$ref": "#/definitions/Paragraph" }
        ]
      },
      "minItems": 1
    }
  },
  "definitions": {
    "List": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "list" },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/definitions/ImportEntry" }
            ]
          },
          "minItems": 1
        }
      }
    },
    "Table": {
      "type": "object",
      "required": ["type", "headers", "rows"],
      "properties": {
        "type": { "const": "table" },
        "headers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 5,
          "description": "Expected columns: Module, Symbol, Alias, Source, Condition"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 5
          },
          "minItems": 1
        }
      }
    },
    "CodeBlock": {
      "type": "object",
      "required": ["type", "language", "value"],
      "properties": {
        "type": { "const": "codeblock" },
        "language": {
          "type": "string",
          "enum": [
            "python", "py", "javascript", "js", "typescript", "ts",
            "rust", "go", "shell", "bash"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Import statements in native syntax"
        },
        "title": {
          "type": "string",
          "description": "Label for this import block"
        }
      }
    },
    "Paragraph": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "paragraph" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "ImportEntry": {
      "type": "object",
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Module or package name (e.g., 'os', 'requests', './local')"
        },
        "symbols": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/definitions/ImportSymbol" }
            ]
          },
          "description": "Specific symbols to import"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Local alias for the module (e.g., 'np' for numpy)"
        },
        "source": {
          "type": "string",
          "enum": [
            "stdlib",
            "pypi",
            "npm",
            "local",
            "mam-module",
            "system"
          ],
          "default": "stdlib",
          "description": "Where this import comes from"
        },
        "style": {
          "type": "string",
          "enum": [
            "absolute",
            "relative",
            "dynamic",
            "lazy",
            "type-only"
          ],
          "default": "absolute",
          "description": "Import style"
        },
        "condition": {
          "type": "string",
          "description": "Conditional import guard (e.g., 'sys.platform == \"linux\"')"
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "If true, import failure is non-fatal"
        },
        "version": {
          "type": "string",
          "description": "Version constraint for this specific import"
        },
        "description": {
          "type": "string",
          "maxLength": 256,
          "description": "Why this import is needed"
        }
      },
      "additionalProperties": false
    },
    "ImportSymbol": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Symbol name to import"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Local alias for this symbol"
        },
        "kind": {
          "type": "string",
          "enum": ["value", "type", "function", "class", "module"],
          "description": "What kind of symbol this is"
        }
      }
    }
  },
  "examples": [
    {
      "type": "section",
      "name": "Imports",
      "content": [
        {
          "type": "list",
          "items": [
            { "module": "os", "source": "stdlib", "description": "File system operations" },
            { "module": "requests", "source": "pypi", "version": "^2.28.0", "description": "HTTP client" },
            { "module": "numpy", "alias": "np", "source": "pypi", "description": "Numerical computing" },
            { "module": "./utils", "source": "local", "style": "relative", "symbols": ["helper_func"] }
          ]
        }
      ]
    }
  ]
}
