{
  "name": "@mam/runtime",
  "version": "0.1.0",
  "description": "MAM Runtime — Execution engine for MAM modules",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./v2": {
      "import": "./dist/v2/index.js",
      "types": "./dist/v2/index.d.ts"
    },
    "./contexts": {
      "import": "./dist/contexts/index.js",
      "types": "./dist/contexts/index.d.ts"
    },
    "./sandboxes": {
      "import": "./dist/sandboxes/index.js",
      "types": "./dist/sandboxes/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mam/ast": "workspace:*",
    "@mam/compiler": "workspace:*",
    "@mam/context-engine": "workspace:*",
    "@mam/intelligence-layer": "workspace:*",
    "@mam/knowledge-engine": "workspace:*",
    "@mam/lsp": "workspace:*",
    "@mam/mcp": "workspace:*",
    "@mam/memory-engine": "workspace:*",
    "@mam/observability": "workspace:*",
    "@mam/package-manager": "workspace:*",
    "@mam/parser": "workspace:*",
    "@mam/security": "workspace:*",
    "@mam/testing": "workspace:*",
    "@mam/token-optimization": "workspace:*",
    "@mam/tool-engine": "workspace:*",
    "@mam/validator": "workspace:*",
    "@mam/visualization": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@types/node": "^20.11.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mam",
    "markdown",
    "runtime",
    "ai",
    "agents"
  ],
  "author": "LifeJiggy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tcp-ecosystems/MAM.git",
    "directory": "runtime/"
  },
  "homepage": "https://github.com/tcp-ecosystems/MAM/tree/main/runtime",
  "bugs": {
    "url": "https://github.com/tcp-ecosystems/MAM/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
