{
  "name": "@mam/runtime",
  "version": "0.1.0",
  "description": "MAM Runtime — Execution engine for MAM modules",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./v2": {
      "import": "./dist/v2/index.js",
      "types": "./dist/v2/index.d.ts"
    },
    "./contexts": {
      "import": "./dist/contexts/index.js",
      "types": "./dist/contexts/index.d.ts"
    },
    "./sandboxes": {
      "import": "./dist/sandboxes/index.js",
      "types": "./dist/sandboxes/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mam/ast": "workspace:*",
    "@mam/validator": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@types/node": "^20.11.0"
  },
  "files": ["dist", "README.md"],
  "keywords": ["mam", "markdown", "runtime", "ai", "agents"],
  "author": "LifeJiggy",
  "license": "MIT"
}