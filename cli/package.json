{
  "name": "@mam/cli",
  "version": "0.1.0",
  "description": "MAM CLI — Command-line interface for Markdown as Module",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mam": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mam/parser": "workspace:*",
    "@mam/ast": "workspace:*",
    "@mam/compiler": "workspace:*",
    "@mam/visualization": "workspace:*",
    "@mam/validator": "workspace:*",
    "@mam/runtime": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.2.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@types/node": "^20.11.0"
  },
  "files": ["dist", "templates"],
  "keywords": ["mam", "markdown", "cli", "ai", "agents"],
  "author": "LifeJiggy",
  "license": "MIT"
}