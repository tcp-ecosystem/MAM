{
  "name": "@mam/cli",
  "version": "0.1.0",
  "description": "MAM CLI — Command-line interface for Markdown as Module",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mam": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mam/parser": "workspace:*",
    "@mam/ast": "workspace:*",
    "@mam/compiler": "workspace:*",
    "@mam/visualization": "workspace:*",
    "@mam/validator": "workspace:*",
    "@mam/runtime": "workspace:*",
    "@mam/memory-engine": "workspace:*",
    "@mam/knowledge-engine": "workspace:*",
    "@mam/observability": "workspace:*",
    "@mam/context-engine": "workspace:*",
    "@mam/security": "workspace:*",
    "@mam/tool-engine": "workspace:*",
    "@mam/mcp": "workspace:*",
    "@mam/token-optimization": "workspace:*",
    "@mam/intelligence-layer": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.2.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@types/node": "^20.11.0"
  },
  "files": ["dist", "README.md"],
  "repository": { "type": "git", "url": "https://github.com/tcp-ecosystems/MAM.git" },
  "keywords": ["mam", "markdown", "module", "sdl", "compiler"],
  "author": "LifeJiggy",
  "license": "MIT",
  "bugs": { "url": "https://github.com/tcp-ecosystems/MAM/issues" },
  "homepage": "https://github.com/tcp-ecosystems/MAM#readme"
}